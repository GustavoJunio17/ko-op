# Senha pedida ao salvar uma edição. Sem ela, salvar só funciona em `pnpm dev`.
ADMIN_PASSWORD=

# Token do GitHub (fine-grained, permissão "Contents: Read and write" no repo ko-op).
# É onde as fichas e o histórico de versões delas são gravados (content/data/<ficha>.json).
GITHUB_TOKEN=

# Opcional na Vercel (detectado pelo deploy via Git). Formato: dono/repositorio
GITHUB_REPO=GustavoJunio17/ko-op
# GITHUB_BRANCH=main
