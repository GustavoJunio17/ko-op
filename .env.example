# Senha pedida ao salvar uma edição. Sem ela, salvar só funciona em `pnpm dev`.
ADMIN_PASSWORD=

# Em produção as edições ficam num Blob store da Vercel (access: private).
# Conecte em Vercel > Storage > Create > Blob; a Vercel injeta BLOB_STORE_ID
# e autentica sozinha, sem token. Em `pnpm dev` sem Blob, vai para content/data/.
# BLOB_STORE_ID=
